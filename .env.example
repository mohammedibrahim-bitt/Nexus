# Postgres connection string. For Supabase, use the SESSION pooler (port 5432),
# not the transaction pooler (port 6543) — the transaction pooler doesn't
# support prepared statements/advisory locks, which migrations need.
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Used to encrypt JWT tokens — set this to a long, random string
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Resend API key — used to send password reset / account verification email.
# Without this set, those emails are just printed to the server console
# instead of delivered. Get a free key at https://resend.com
RESEND_API_KEY=

# The SEO Research Agent is bring-your-own-keys: each staff user sets their own SerpApi key
# and their own AI provider + API key on their dashboard profile — no keys are configured here.
#
# Optional: override the default model used per AI provider.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-flash-latest
