# SQLite database file path
DATABASE_URL=file:./payload.db

# Used to encrypt JWT tokens — set this to a long, random string
PAYLOAD_SECRET=mohamedemadeldinezzeldinmohamedali
# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=local-dev-cron-secret

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# The SEO Research Agent is bring-your-own-keys: each staff user sets their own SerpApi key
# and their own AI provider + API key on their dashboard profile — no keys are configured here.
#
# Optional: override the default model used per AI provider.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-2.0-flash
