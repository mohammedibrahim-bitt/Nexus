# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# Postgres connection string.
#
# For Supabase, running `payload migrate` (locally or in CI) needs the
# SESSION pooler (port 5432) — the transaction pooler doesn't support
# prepared statements/advisory locks, which migrations require.
#
# For the deployed app itself on Vercel, use the TRANSACTION pooler (port
# 6543) instead: serverless functions open many short-lived connections, and
# the session pooler's connection cap is exhausted quickly under that
# pattern. Set DATABASE_URL to the transaction pooler URL in Vercel's
# project env vars; only your one-off migration runs need the session one.
DATABASE_URL=

# Used to encrypt JWT tokens — set this to a long, random string
PAYLOAD_SECRET=

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=

# Used to validate preview requests
PREVIEW_SECRET=

# Resend API key — used to send password reset / account verification email.
# Without a verified domain at resend.com/domains, Resend only delivers to the
# account owner's own address; in dev, failures are logged rather than thrown.
RESEND_API_KEY=

# --- Supabase Storage (tenant clone assets) ---
# Separate service from DATABASE_URL above. The Storage API URL is
# https://<project-ref>.supabase.co — NOT the Postgres connection string.
SUPABASE_URL=

# Service-role key from Supabase dashboard > Project Settings > API.
# Bypasses RLS and has full project access — keep it server-side only.
# Never prefix with NEXT_PUBLIC_, or it gets bundled into client JS.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for cloned tenant assets. Kept private; served via signed URLs.
SUPABASE_STORAGE_BUCKET=tenant-assets

# --- Supabase Storage (Media collection uploads, S3-compatible) ---
# Required for Vercel: serverless functions have a read-only filesystem
# outside /tmp, so local-disk uploads (Media's default) don't survive past
# the request that made them. Without these set, Media falls back to local
# disk — fine for local dev, broken in production on Vercel.
#
# Get these from the Supabase dashboard > Project Settings > Storage > S3
# Connection. These are NOT the same as SUPABASE_SERVICE_ROLE_KEY above.
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Storage bucket for editorial Media uploads (post images, avatars, etc).
# Keep this separate from SUPABASE_STORAGE_BUCKET above — that one is for
# cloned tenant-site assets, not day-to-day editorial uploads.
SUPABASE_MEDIA_BUCKET=media
